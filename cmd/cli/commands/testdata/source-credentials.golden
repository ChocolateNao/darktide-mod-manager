$ dmm --config <config> --cache <cache> --storage <storage> source list
o ID  NAME  ENABLED  AUTH  SEARCH  NEEDS KEY  HAS KEY
o github  GitHub Releases  no  no  yes  no  no
o local  Local folders  yes  no  yes  no  no
o nexus  Nexus Mods  yes  no  yes  yes  no
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source auth nexus --api-key unchecked-key --no-verify
o stored credentials for nexus (not verified)
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source list
o ID  NAME  ENABLED  AUTH  SEARCH  NEEDS KEY  HAS KEY
o github  GitHub Releases  no  no  yes  no  no
o local  Local folders  yes  no  yes  no  no
o nexus  Nexus Mods  yes  no  yes  yes  yes
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.nexus.api_key
e error: NOT_FOUND: sources.nexus.api_key holds a credential and is not readable through the configuration API
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source auth nexus --forget
o forgot credentials for nexus
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source list
o ID  NAME  ENABLED  AUTH  SEARCH  NEEDS KEY  HAS KEY
o github  GitHub Releases  no  no  yes  no  no
o local  Local folders  yes  no  yes  no  no
o nexus  Nexus Mods  yes  no  yes  yes  no
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source auth nexus --forget
e error: NOT_FOUND: source "nexus" has no stored API key
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source test nexus
o SOURCE  STATE  DETAIL
o nexus  not configured  no credential stored; browsing still works
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source auth nexus --forget --api-key k
e error: INVALID_ARGUMENT: --forget cannot be combined with a key or with --user
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source auth nexus --forget --no-verify
e error: INVALID_ARGUMENT: --forget and --no-verify ask for opposite things
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source auth local --forget
e error: NOT_FOUND: source "local" has no stored API key
! exit 1
