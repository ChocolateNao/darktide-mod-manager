$ dmm --config <config> --cache <cache> --storage <storage> source search better
o ID  VERSION  SOURCE  NAME
o betterui  0.0.0  local  betterui
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --source local
o ID  VERSION  SOURCE  NAME
o betterui  0.0.0  local  betterui
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --source local --tag archive
e error: INVALID_ARGUMENT: --source searches one source with a text query only, so --tag cannot be used with it; drop --source to search every enabled source with those filters
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source search nothing-matches-this
o Nothing matched.
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --sort downloads
o ID  VERSION  SOURCE  NAME
o betterui  0.0.0  local  betterui
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --sort sideways
e error: INVALID_ARGUMENT: unknown sort "sideways"; use relevance, updated, downloads or name
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> source search better --page 0 --page-size 1
o ID  VERSION  SOURCE  NAME
o betterui  0.0.0  local  betterui
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --page 99
o Nothing matched.
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> source search better --source nosuchsource
e error: SOURCE_NOT_FOUND: unknown mod source "nosuchsource"
! exit 1
