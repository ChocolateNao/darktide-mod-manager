$ dmm --config <config> --cache <cache> --storage <storage> config show
o # <config>
o {
o   "sources": {
o   "github": {
o   "enabled": false
o   },
o   "local": {
o   "paths": [
o   "<local>"
o   ],
o   "enabled": true
o   },
o   "nexus": {
o   "enabled": false
o   },
o   "vortex": {
o   "enabled": false
o   }
o   },
o   "game": {
o   "path": "<game>",
o   "source": "auto",
o   "mods_folder_override": "",
o   "auto_detect": true
o   },
o   "ui": {
o   "theme": "system",
o   "language": "en",
o   "compact_mode": false
o   },
o   "advanced": {
o   "log_level": "info",
o   "enable_experimental": false
o   },
o   "storage": {
o   "path": "<storage>",
o   "backup_retention_days": 7
o   },
o   "auto_update": {
o   "check_interval_hours": 24,
o   "enabled": false,
o   "download_automatically": false,
o   "notify_on_update": true
o   },
o   "cache": {
o   "path": "<cache>",
o   "max_size_gb": 5,
o   "max_age_days": 30,
o   "verify_hashes": true
o   },
o   "logging": {
o   "level": "info",
o   "max_size_mb": 10,
o   "max_backups": 5,
o   "max_age_days": 30,
o   "compress": true
o   },
o   "hooks": {
o   "default_timeout": 30,
o   "allow_network": false,
o   "allow_file_write": true,
o   "max_timeout": 600
o   }
o }
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config edit
o settings file: <config>
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get game.path
o <game>
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get  CACHE.max_size_gb  
o 5
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get cache.max_size_gb
o 5
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config set cache.max_size_gb 12
o cache.max_size_gb = 12
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get cache.max_size_gb
o 12
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config set ui.compact_mode yes
o ui.compact_mode = yes
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config set ui.compact_mode maybe
e error: INVALID_ARGUMENT: cannot set ui.compact_mode: "maybe" is not a yes/no value
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set cache.max_size_gb twelve
e error: INVALID_ARGUMENT: cannot set cache.max_size_gb: "twelve" is not a whole number
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set cache.max_size_gb -1
e error: INVALID_ARGUMENT: cannot set cache.max_size_gb: -1 is out of range: expected 0 to 1000000
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set no.such.key x
e error: NOT_FOUND: no such configuration key: "no.such.key"
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set  x
e error: INVALID_ARGUMENT: configuration key must not be blank
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config get no.such.key
e error: NOT_FOUND: no such configuration key: "no.such.key"
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config get  
e error: INVALID_ARGUMENT: configuration key must not be blank
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config get
e error: accepts 1 arg(s), received 0
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set cache.max_size_gb
e error: accepts 2 arg(s), received 1
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set sources.local.paths <local>,/another/folder
o sources.local.paths = <local>,/another/folder
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.local.paths
o <local>,/another/folder
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config set sources.local.options.max_releases 5
o sources.local.options.max_releases = 5
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.local.options.max_releases
o 5
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config set sources.local.api_key written-not-read-back
o sources.local.api_key = written-not-read-back
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.local.api_key
e error: NOT_FOUND: sources.local.api_key holds a credential and is not readable through the configuration API
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set sources.nosuchsource.enabled yes
o sources.nosuchsource.enabled = yes
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.nosuchsource.enabled
o true
! exit 0
$ dmm --config <config> --cache <cache> --storage <storage> config get sources.local.nosuchfield
e error: NOT_FOUND: source "local" has no setting "nosuchfield"
! exit 1
$ dmm --config <config> --cache <cache> --storage <storage> config set sources.local. x
e error: NOT_FOUND: cannot set sources.local.: source "local" has no setting ""
! exit 1
